# PAM stack for user sessions started by greetd.
auth      required  pam_unix.so nullok
account   required  pam_unix.so
password  required  pam_unix.so sha512 shadow nullok
# Mark the logind session as Wayland before pam_elogind registers it (Mutter needs a graphical session).
session   required  pam_env.so conffile=/etc/meldra/session-env.conf readenv=0
session   required  pam_unix.so
session   required  pam_elogind.so
