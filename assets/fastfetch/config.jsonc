{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/etc/xdg/fastfetch/meldra-logo.ansi",
    "width": 42,
    "height": 14,
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;134;220;214", "title": "38;2;248;186;138", "separator": "38;2;156;152;204" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    "separator",
    { "type": "wm",       "key": "WM" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "memory",   "key": "Memory" },
    "break",
    "colors"
  ]
}
